---
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const t = getDictionary(Astro.props.lang).services;
---

<Section id="servicios">
  <SectionHeader id="servicios" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />

  <ul class="grid gap-4 md:grid-cols-3 md:gap-6">
    {t.items.map((service) => (
      <li data-reveal>
        <article
          class="service-card group relative flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface/70 p-6 shadow-card transition-colors duration-(--dur-base) hover:border-accent/40 md:p-8"
          data-tilt
        >
          <div class="grid size-12 place-items-center rounded-xl border border-accent/20 bg-accent/10 text-accent">
            <Icon name={service.icon} class="size-6" />
          </div>
          <h3 class="mt-6 text-h3 font-medium">{service.title}</h3>
          <p class="mt-3 flex-1">{service.text}</p>
          <ul class="mt-6 space-y-3 border-t border-line pt-6 text-sm">
            {service.features.map((feature) => (
              <li class="flex gap-2.5 text-ink">
                <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" strokeWidth={2} />
                {feature}
              </li>
            ))}
          </ul>
        </article>
      </li>
    ))}
  </ul>
</Section>
