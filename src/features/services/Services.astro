---
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const t = getDictionary(Astro.props.lang).services;
---

<Section id="servicios">
  <SectionHeader id="servicios" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />

  <ul class="grid gap-4 md:grid-cols-3 md:gap-6">
    {t.items.map((service) => (
      <li data-reveal>
        <article
          class="group relative isolate flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface/70 p-6 shadow-card transition-[border-color,transform] duration-500 ease-out-expo hover:border-accent/40 md:p-8"
          data-tilt
        >
          <span
            class="pointer-events-none absolute top-0 left-0 -z-10 size-80 rounded-full bg-[radial-gradient(closest-side,rgb(217_180_90/0.16),transparent)] opacity-0 transition-opacity duration-(--dur-slow) group-hover:opacity-100"
            aria-hidden="true"
            data-spotlight
          ></span>
          <span
            class="pointer-events-none absolute inset-x-6 top-0 h-px bg-linear-to-r from-transparent via-accent to-transparent opacity-0 transition-opacity duration-(--dur-slow) group-hover:opacity-100"
            aria-hidden="true"
          ></span>
          <div class="grid size-12 place-items-center rounded-xl border border-accent/20 bg-accent/10 text-accent transition-transform duration-(--dur-slow) ease-spring group-hover:-translate-y-1">
            <Icon name={service.icon} class="size-6" />
          </div>
          <h3 class="mt-6 text-h3 font-medium">{service.title}</h3>
          <p class="mt-3 flex-1">{service.text}</p>
          <ul class="mt-6 space-y-3 border-t border-line pt-6 text-sm">
            {service.features.map((feature) => (
              <li class="flex gap-2.5 text-ink">
                <Icon name="check" class="mt-0.5 size-4 shrink-0 text-accent" strokeWidth={2} />
                {feature}
              </li>
            ))}
          </ul>
        </article>
      </li>
    ))}
  </ul>
</Section>
