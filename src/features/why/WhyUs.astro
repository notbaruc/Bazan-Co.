---
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const t = getDictionary(Astro.props.lang).why;
---

<Section id="por-que" class="bg-surface/40">
  <SectionHeader id="por-que" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />

  <ul class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {t.items.map((item) => (
      <li class="bg-bg p-6 md:p-8" data-reveal>
        <span class="grid size-12 place-items-center rounded-xl border border-accent/20 bg-accent/10 text-accent">
          <Icon name={item.icon} class="size-6" />
        </span>
        <h3 class="mt-6 text-h3 font-medium">{item.title}</h3>
        <p class="mt-2 text-[0.9375rem]">{item.text}</p>
      </li>
    ))}
  </ul>
</Section>
