---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import Pending from '@/components/ui/Pending.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { getDictionary, isPending, type Locale } from '@/i18n';
import riesImage from '@/assets/images/ries-chihuahua.webp';
import soldadurasImage from '@/assets/images/soldaduras-y-equipos.webp';

interface Props {
  lang: Locale;
}

const dict = getDictionary(Astro.props.lang);
const t = dict.portfolio;
const pendingLabel = dict.a11y.pendingLabel;

/** Capturas reales de cada sitio (tomadas del sitio publicado). */
const images: Record<string, ImageMetadata> = {
  soldaduras: soldadurasImage,
  ries: riesImage,
};
---

<Section id="portafolio">
  <SectionHeader id="portafolio" eyebrow={t.eyebrow} title={t.title} lead={t.lead} />

  <ul class="grid gap-6 lg:grid-cols-3">
    {t.projects.map((project) => {
      const image = images[project.id];
      return (
        <li data-reveal>
          <article
            class="group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface/70 shadow-card"
            aria-labelledby={`project-${project.id}`}
          >
            <div class="relative aspect-16/10 overflow-hidden border-b border-line bg-elevated">
              {image ? (
                <Picture
                  src={image}
                  alt={project.imageAlt}
                  formats={['avif', 'webp']}
                  widths={[480, 720, 960, 1440]}
                  sizes="(min-width: 1024px) 380px, (min-width: 640px) 90vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="portfolio-image size-full object-cover object-top"
                />
              ) : (
                <div class="grid size-full place-items-center p-6 text-center">
                  <div class="flex flex-col items-center gap-3">
                    <Icon name="image" class="size-8 text-ink-muted" />
                    <Pending
                      text={`[PENDIENTE USUARIO] ${t.labels.noImage}`}
                      label={pendingLabel}
                    />
                  </div>
                </div>
              )}
            </div>

            <div class="flex flex-1 flex-col p-6">
              {isPending(project.category) ? (
                <Pending text={project.category} label={pendingLabel} class="self-start" />
              ) : (
                <p class="font-mono text-xs tracking-wide text-accent uppercase">
                  {project.category}
                </p>
              )}
              <h3 id={`project-${project.id}`} class="mt-3 font-display text-3xl font-normal">
                {project.name}
              </h3>

              <dl class="mt-5 flex-1 space-y-4 text-[0.9375rem]">
                {(
                  [
                    [t.labels.problem, project.problem],
                    [t.labels.solution, project.solution],
                    [t.labels.result, project.result],
                  ] as const
                ).map(([label, value]) => (
                  <div>
                    <dt class="text-sm font-medium text-ink">{label}</dt>
                    <dd class="mt-1">
                      {isPending(value) ? <Pending text={value} label={pendingLabel} /> : value}
                    </dd>
                  </div>
                ))}
                <div>
                  <dt class="text-sm font-medium text-ink">{t.labels.testimonial}</dt>
                  <dd class="mt-1">
                    {isPending(project.testimonial) ? (
                      <Pending text={project.testimonial} label={pendingLabel} />
                    ) : (
                      <blockquote>{project.testimonial}</blockquote>
                    )}
                  </dd>
                </div>
              </dl>

              <div class="mt-6 border-t border-line pt-5">
                <p id={`stack-${project.id}`} class="text-sm font-medium text-ink">
                  {t.labels.stack}
                </p>
                <ul class="mt-3 flex flex-wrap gap-2" aria-labelledby={`stack-${project.id}`}>
                  {project.stack.map((tech) =>
                    isPending(tech) ? (
                      <li>
                        <Pending text={tech} label={pendingLabel} />
                      </li>
                    ) : (
                      <li class="rounded-full border border-line-strong px-3 py-1 font-mono text-xs text-ink-secondary">
                        {tech}
                      </li>
                    ),
                  )}
                </ul>
                {project.url && (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-5 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-accent hover:text-accent-hi"
                    data-project={project.id}
                  >
                    {t.labels.visit}
                    <span class="sr-only">
                      {project.name} {dict.a11y.externalLink}
                    </span>
                    <Icon name="external-link" class="size-4" />
                  </a>
                )}
              </div>
            </div>
          </article>
        </li>
      );
    })}
  </ul>
</Section>
