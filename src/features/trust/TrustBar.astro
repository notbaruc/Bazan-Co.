---
import { getDictionary, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const t = getDictionary(Astro.props.lang);
---

<section aria-label={t.trust.label} class="border-y border-line bg-surface/60">
  <div class="container-page py-10 md:py-12">
    <dl class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
      {t.trust.items.map((item) => (
        <div class="flex flex-col border-l border-accent/30 pl-4">
          <dt class="mt-2 text-sm text-ink-muted">{item.label}</dt>
          <dd
            class="order-first font-display text-4xl leading-none text-ink tabular-nums md:text-5xl"
            data-counter={item.number ?? undefined}
            data-prefix={item.prefix}
            data-suffix={item.suffix}
          >
            {item.value}
          </dd>
        </div>
      ))}
    </dl>
    <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-6 text-sm text-ink-secondary">
      {t.trust.credentials.map((credential) => (
        <li class="flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />
          {credential}
        </li>
      ))}
    </ul>
  </div>
</section>
