---
import Icon from '@/components/ui/Icon.astro';
import Pending from '@/components/ui/Pending.astro';
import Section from '@/components/ui/Section.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { getDictionary, isPending, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const dict = getDictionary(Astro.props.lang);
const t = dict.faq;
---

<Section id="faq">
  <div class="grid gap-10 lg:grid-cols-[2fr_3fr] lg:gap-16">
    <SectionHeader id="faq" eyebrow={t.eyebrow} title={t.title} class="lg:mb-0" />

    <div class="divide-y divide-line border-y border-line">
      {t.items.map((item) => (
        <details class="faq-item group" name="faq">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-lg text-ink [&::-webkit-details-marker]:hidden">
            <span>{item.q}</span>
            <span class="grid size-8 shrink-0 place-items-center rounded-full border border-line-strong text-accent transition-transform duration-(--dur-base) ease-out-expo group-open:rotate-45">
              <Icon name="plus" class="size-4" strokeWidth={2} />
            </span>
          </summary>
          <div class="pr-14 pb-6">
            <p>{item.a}</p>
            {isPending(item.pending) && (
              <Pending text={item.pending} label={dict.a11y.pendingLabel} class="mt-3" />
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</Section>
