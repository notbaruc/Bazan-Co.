---
import { Font } from 'astro:assets';
import CookieBanner from '@/features/consent/CookieBanner.astro';
import LanguageSuggestion from '@/features/i18n/LanguageSuggestion.astro';
import Footer from '@/features/layout/Footer.astro';
import Navbar from '@/features/layout/Navbar.astro';
import WhatsAppFab from '@/features/whatsapp/WhatsAppFab.astro';
import {
  defaultLocale,
  getDictionary,
  locales,
  otherLocale,
  routes,
  type Locale,
  type RouteName,
} from '@/i18n';
import { buildStructuredData } from '@/lib/seo';
import { site as business } from '@/lib/site';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Locale;
  /** Página actual; sin ruta (404) no se emiten alternos de idioma. */
  route?: RouteName;
  noindex?: boolean;
}

const { title, description, lang, route, noindex = false } = Astro.props;
const t = getDictionary(lang);
const site = Astro.site ?? new URL(Astro.url.origin);

const homeHref = route === 'home' ? '' : routes.home[lang];
const privacyHref = routes.privacy[lang];
const switchHref = route ? routes[route][otherLocale(lang)] : routes.home[otherLocale(lang)];
const canonical = route ? new URL(routes[route][lang], site).href : undefined;
const alternates = route
  ? locales.map((locale) => ({ locale, href: new URL(routes[route][locale], site).href }))
  : [];
const xDefault = route ? new URL(routes[route][defaultLocale], site).href : undefined;
const siteUrl = site.href.replace(/\/$/, '');
const ogImage = new URL(t.meta.ogImage, site).href;
const ogAlternateLocale = getDictionary(otherLocale(lang)).meta.ogLocale;
const structuredData = canonical
  ? JSON.stringify(buildStructuredData({ lang, pageUrl: canonical, siteUrl, t }))
  : undefined;
/** Verificación de Google Search Console (la misma del sitio anterior). */
const googleSiteVerification = 'vkZJiBpk1G6FxHcrMStEB7mfx0OqFYhLGhKE58p7JNI';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map(({ locale, href }) => (
      <link rel="alternate" hreflang={locale} href={href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <script is:inline>
      // Antes del primer render:
      // 1) Si el visitante eligió antes otro idioma, va directo a esa versión (sin parpadeo).
      // 2) Marca que hay JS y activa las animaciones solo si no pidió reducir movimiento.
      (function () {
        const root = document.documentElement;
        try {
          const preferred = localStorage.getItem('bazan-lang');
          if (preferred && preferred !== root.lang) {
            const alt = document.querySelector(
              'link[rel="alternate"][hreflang="' + preferred + '"]',
            );
            if (alt) {
              // Solo la ruta: así funciona igual en localhost y en los deploy previews.
              location.replace(new URL(alt.href).pathname + location.hash);
              return;
            }
          }
        } catch {
          // Almacenamiento bloqueado: se queda en esta versión.
        }
        root.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion');
        }
      })();
    </script>
    <meta name="theme-color" content="#07090f" />
    <meta name="google-site-verification" content={googleSiteVerification} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:locale:alternate" content={ogAlternateLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-instrument" preload />
    <Font cssVariable="--font-geist" />
    <Font cssVariable="--font-geist-mono" />
  </head>
  <body>
    <a
      href="#contenido"
      class="fixed top-3 left-3 z-[60] -translate-y-24 rounded-full bg-accent px-5 py-3 font-medium text-ink-inverse focus:translate-y-0"
    >
      {t.a11y.skipToContent}
    </a>
    <Navbar lang={lang} homeHref={homeHref} switchHref={switchHref} />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} homeHref={homeHref} privacyHref={privacyHref} />
    <WhatsAppFab lang={lang} />
    <CookieBanner lang={lang} privacyHref={privacyHref} />
    <LanguageSuggestion lang={lang} href={switchHref} />
    <!-- Datos estructurados al final: no retrasan el primer render (el <head> queda más liviano). -->
    {structuredData && <script type="application/ld+json" set:html={structuredData} />}
    <script>
      import { initAnalytics } from '@/lib/analytics';
      import { initMotion } from '@/lib/motion';
      initMotion();
      initAnalytics();
    </script>
  </body>
</html>
