---
import RichText from './RichText.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { id, eyebrow, title, lead, align = 'left', class: className } = Astro.props;
const centered = align === 'center';
---

<header
  class:list={[
    'mb-12 max-w-(--container-prose) md:mb-16',
    centered && 'mx-auto text-center',
    className,
  ]}
>
  <p
    class:list={[
      'mb-5 flex items-center gap-3 font-mono text-eyebrow text-accent uppercase',
      centered && 'justify-center',
    ]}
  >
    <span class="h-px w-8 bg-accent/60" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <h2 id={`${id}-title`} class="font-display text-h2 font-normal tracking-[-0.01em]">
    <RichText text={title} />
  </h2>
  {lead && <p class="mt-5 text-lead text-ink-secondary">{lead}</p>}
</header>
