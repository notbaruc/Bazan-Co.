---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'whatsapp' | 'ghost';
type Size = 'md' | 'sm';

/** Enlace con estilo de botón (todas las acciones del sitio son navegación). */
type Props = HTMLAttributes<'a'> & {
  href: string;
  variant?: Variant;
  size?: Size;
  external?: boolean;
  class?: string;
};

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  class: className,
  ...rest
} = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-accent text-ink-inverse hover:bg-accent-hi shadow-glow',
  secondary:
    'border border-line-strong bg-white/[0.03] text-ink hover:border-accent/50 hover:bg-white/[0.06]',
  whatsapp: 'bg-whatsapp text-[#03140a] hover:brightness-110',
  ghost: 'text-ink hover:text-accent',
};

const sizes: Record<Size, string> = {
  md: 'min-h-12 px-6 text-[0.9375rem]',
  sm: 'min-h-11 px-4 text-sm',
};

const classes = [
  'group/btn relative inline-flex items-center justify-center gap-2 rounded-full font-medium',
  'transition-[background-color,border-color,color,filter] duration-(--dur-base) ease-out-expo',
  variants[variant],
  sizes[size],
  className,
];
---

<a
  href={href}
  class:list={classes}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  {...rest}
>
  <slot />
</a>
