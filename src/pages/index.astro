---
import BaseLayout from '@/layouts/BaseLayout.astro';

const swatches = [
  ['bg', 'bg-bg'],
  ['surface', 'bg-surface'],
  ['elevated', 'bg-elevated'],
  ['ink', 'bg-ink'],
  ['ink-secondary', 'bg-ink-secondary'],
  ['ink-muted', 'bg-ink-muted'],
  ['accent', 'bg-accent'],
  ['accent-hi', 'bg-accent-hi'],
  ['support', 'bg-support'],
] as const;
---

<BaseLayout
  title="Bazan & Co. — Tokens"
  description="Página temporal de verificación de design tokens."
>
  <main class="container-page py-(--spacing-section)">
    <p class="font-mono text-eyebrow text-accent uppercase">Fase 1 · Design tokens</p>
    <h1 class="mt-4 font-display text-display">
      No construimos páginas web. <em class="text-accent">Diseñamos máquinas de conversión.</em>
    </h1>
    <p class="mt-6 max-w-(--container-prose) text-lead">
      Página temporal para validar paleta, tipografía y escala. Se elimina en la Fase 2.
    </p>
    <ul class="mt-10 grid grid-cols-3 gap-3 sm:grid-cols-9">
      {swatches.map(([name, cls]) => (
        <li class="text-xs">
          <span class:list={['block aspect-square rounded-md border border-line', cls]} />
          <span class="mt-2 block font-mono text-ink-muted">{name}</span>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
